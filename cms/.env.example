# Generate local values with npm run setup:local. Never commit .env.local.
PAYLOAD_SECRET=
DATABASE_URL=postgresql://cms:CHANGE_ME@127.0.0.1:55432/shibly_cms
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional server-only override for the CMS origin (no build-time substitution).
CMS_SERVER_URL=
# Set the real public HTTPS origin and explicitly allow indexing only for release.
SITE_URL=
PUBLIC_INDEXING_ENABLED=false
# local enables a loopback-only PostgreSQL cluster; production uses an external database.
CMS_ENV=local
# Database schema push is only for the disposable integration-test database.
CMS_TEST_SCHEMA_PUSH=false
LOCAL_ADMIN_EMAIL=shibly.work@gmail.com

# Contact submissions use /api/contact on this application. Enable only after review.
CONTACT_SUBMISSIONS_ENABLED=false
CONTACT_RETENTION_DAYS=180
# disabled saves inquiries without outbound email. capture is local/test only.
CONTACT_NOTIFICATION_PROVIDER=disabled
# One or more recipient email addresses, separated by commas (up to 50).
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=
RESEND_API_KEY=
# Private secret for the scheduled POST /api/contact/maintenance endpoint.
CONTACT_WORKER_SECRET=
# Optional: set ONLY when a trusted proxy overwrites this header on every request.
CONTACT_TRUSTED_IP_HEADER=
# Optional portrait setting retained from the original website.
NEXT_PUBLIC_PORTRAIT_URL=
